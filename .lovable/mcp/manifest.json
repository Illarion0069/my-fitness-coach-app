{
  "version": 1,
  "sdk_version": "0.22.2",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://yzzgkjwyhnvlyqldvzxf.supabase.co/auth/v1",
    "accepted_audiences": [
